{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "launchpad",
  "title": "Launchpad",
  "description": "Browse and launch installed macOS applications in a grid view — a Launchpad replacement for macOS 26 Tahoe.",
  "icon": "icon.png",
  "author": "ALs",
  "platforms": [
    "macOS"
  ],
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "launchpad",
      "title": "Launchpad",
      "description": "Open the app grid",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "2.6.3",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "22.19.17",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.0.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "^5.8.2",
    "vitest": "5.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish": "npx @raycast/api@latest publish"
  }
}
